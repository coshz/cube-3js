{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "rootDir": "src",
        "outDir": "dist",
        "skipLibCheck": true,
        "incremental":true
    },
    "include": [
        "src/*",
        "test/**/*"
    ],
}